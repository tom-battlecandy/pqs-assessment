{
  "name": "pqs-training-certification",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n client,api -c cyan,green \"vite --host 0.0.0.0 --port 5173\" \"tsx watch server/index.ts\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "prettier --check . && npm run lint && npm run typecheck && npm run build",
    "db:seed": "node -e \"console.log('Database seed will be added with the database schema.')\"",
    "db:reset": "node -e \"console.log('Database reset will be added with the database schema.')\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/vue-query": "^5.83.0",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "tailwindcss": "^4.1.11",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1",
    "vuetify": "^3.9.3",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^24.1.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.0",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.3.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.0.4"
  },
  "engines": {
    "node": ">=22.12"
  }
}
